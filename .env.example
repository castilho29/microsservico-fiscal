# Dados da empresa (SEFAZ-PA)
NFE_UF=PA
NFE_AMBIENTE=2                    # 1 = producao, 2 = homologacao — comece SEMPRE em 2
NFE_RAZAO_SOCIAL="Nome do mercado LTDA"
NFE_CNPJ=00000000000000
NFE_INSCRICAO_ESTADUAL=000000000
NFE_CSC=coloque-o-csc-gerado-no-portal-sefaz-pa
NFE_CSC_ID=000001

# Certificado digital A1
NFE_CERTIFICADO_PATH=./certs/certificado.pfx
NFE_CERTIFICADO_SENHA=senha-do-certificado

# Supabase (usar a service_role key aqui, NUNCA a anon key —
# esse microsservico roda em servidor confiavel, nao no navegador)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Token simples pra proteger os endpoints deste microsservico
# (o backend Supabase manda esse token no header ao chamar)
MICROSERVICO_TOKEN=defina-um-token-longo-e-aleatorio-aqui
